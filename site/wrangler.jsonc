{
  // Deploy from this directory with `npx wrangler deploy`.
  "name": "proofathome-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "proofathome.org", "custom_domain": true },
    { "pattern": "www.proofathome.org", "custom_domain": true },
    { "pattern": "proofathome.com", "custom_domain": true },
    { "pattern": "www.proofathome.com", "custom_domain": true },
    { "pattern": "proofathome.dev", "custom_domain": true },
    { "pattern": "proofathome.net", "custom_domain": true }
  ]
}
